{
  "name": "playwright-typescript-testing",
  "version": "1.0.0",
  "description": "Educational Playwright TypeScript Testing Framework for Industrial Placement Students",
  "main": "index.js",
  "scripts": {
    "site:serve": "node scripts/serve-site.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://demo.playwright.dev"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "typescript",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
